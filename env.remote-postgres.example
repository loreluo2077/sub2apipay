# Remote PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public&sslmode=require"

# Upstream platform integration
SUB2API_BASE_URL="http://localhost:3001"
SUB2API_ADMIN_API_KEY="mock-sub2api-admin-key"

# Local admin access
ADMIN_TOKEN="replace-with-a-long-random-admin-token"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# White-label branding
NEXT_PUBLIC_APP_NAME="YourPay"
NEXT_PUBLIC_APP_DESCRIPTION="Your payment and subscription platform"
NEXT_PUBLIC_PLATFORM_NAME="Your Platform"
NEXT_PUBLIC_PRODUCT_NAME_PREFIX="YourPay"
NEXT_PUBLIC_PRODUCT_NAME_SUFFIX="CNY"
NEXT_PUBLIC_DEV_FRONTEND_BYPASS="false"
NEXT_PUBLIC_DEV_FRONTEND_TOKEN="mock-user-token"
NEXT_PUBLIC_DEV_FRONTEND_USER_ID="1001"
NEXT_PUBLIC_DEV_FRONTEND_USER_NAME="demo-user"
NEXT_PUBLIC_DEV_FRONTEND_USER_EMAIL="demo-user@example.com"

# Providers and visible payment types
PAYMENT_PROVIDERS="easypay"
ENABLED_PAYMENT_TYPES="alipay,wxpay"

# Local mock EasyPay
EASY_PAY_PID="mock-pid"
EASY_PAY_PKEY="mock-pkey"
EASY_PAY_API_BASE="http://localhost:3001"
EASY_PAY_NOTIFY_URL="http://localhost:3000/api/easy-pay/notify"
EASY_PAY_RETURN_URL="http://localhost:3000/pay/result"

# Safe local defaults
ORDER_TIMEOUT_MINUTES="5"
MIN_RECHARGE_AMOUNT="1"
MAX_RECHARGE_AMOUNT="1000"
MAX_DAILY_RECHARGE_AMOUNT="0"
